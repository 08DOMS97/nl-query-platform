# --- Conexiones de prueba (banco de datos local en Docker) ---
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_DATABASE=testdb
DB_POSTGRES_USER=testuser
DB_POSTGRES_PASSWORD=

DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=testdb
DB_MYSQL_USER=testuser
DB_MYSQL_PASSWORD=

DB_MARIADB_HOST=localhost
DB_MARIADB_PORT=3307
DB_MARIADB_DATABASE=testdb
DB_MARIADB_USER=testuser
DB_MARIADB_PASSWORD=

DB_MSSQL_HOST=localhost
DB_MSSQL_PORT=1433
DB_MSSQL_DATABASE=testdb
DB_MSSQL_USER=testuser
DB_MSSQL_PASSWORD=
# true solo en local, contra el certificado autofirmado del contenedor de pruebas.
# NUNCA en true contra un SQL Server real en producción (riesgo de MITM).
DB_MSSQL_TRUST_SERVER_CERTIFICATE=false

# --- Google Cloud ---
GCP_PROJECT_ID=
GCP_LOCATION=global
VERTEX_AI_MODEL=gemini-3.8-flash

# --- Firebase ---
FIREBASE_PROJECT_ID=

# --- Módulo de uso y costos (opcional) ---
# Precio de lista de Gemini 3.8 Flash en USD por millón de tokens, usado para
# estimar el costo de cada llamada a /generateSQL. Si se omiten, se usan los
# valores por defecto en vertexAiPricing.service.ts (verificar vigencia en
# cloud.google.com/vertex-ai/generative-ai/pricing o en el catálogo de Cloud Billing).
VERTEX_AI_PRICE_INPUT_PER_1M_USD=
VERTEX_AI_PRICE_OUTPUT_PER_1M_USD=

# --- Servidor local de desarrollo ---
PORT=8080

# Permite omitir la verificación de JWT de Firebase SOLO en local, mientras no exista
# proyecto Firebase. NUNCA poner esto en true fuera de tu máquina de desarrollo.
NLQP_ALLOW_DEV_AUTH_BYPASS=false

# Manda a Gemini los índices compuestos de cada tabla (columnas en orden) y una regla
# para aprovecharlos. Apagado: el prompt es el mismo de la evaluación. Activarlo si el
# EXPLAIN de una base real muestra consultas que no usan sus índices compuestos.
NLQP_PROMPT_INDICES_COMPUESTOS=false

# --- Usuarios de prueba (Firebase Auth) ---
# Exclusivos de las pruebas automáticas (test:api, test:ui, test:token, eval:gemini); lo
# que dejan en Firestore se borra al terminar (npm run limpiar:pruebas). Las contraseñas
# van solo acá, nunca en el código.
NLQP_TEST_USER_EMAIL=nlqp-ci-tecnico@example.com
NLQP_TEST_USER_PASSWORD=
NLQP_USUARIO_EMAIL=nlqp-ci-usuario@example.com
NLQP_USUARIO_PASSWORD=
# Superadministrador de las pruebas (gestión de usuarios). Se le da el permiso con
# `npm run set:superadmin -- <correo>`.
NLQP_SUPERADMIN_EMAIL=nlqp-ci-superadmin@example.com
NLQP_SUPERADMIN_PASSWORD=
# Usuarios de la demo, para entrar desde la interfaz (ninguna prueba los usa):
# nlqp-test@example.com (técnico) y nlqp-usuario@example.com (no técnico).
NLQP_DEMO_TECNICO_PASSWORD=
NLQP_DEMO_USUARIO_PASSWORD=

# --- Límites de ejecución (ver nlqp/docs/RENDIMIENTO_E_INTEGRIDAD.md) ---
# Todo o nada: al superarse, se responde error (504 / 413), nunca un resultado parcial.
# Tiempo máximo de una consulta, aplicado DENTRO del motor (lo cancela la propia base).
# Cada conexión tiene el suyo (lo fija el técnico en la pantalla Conexiones, de 10 s a
# 60 min); este es el de defecto para las conexiones que no lo fijaron (8 min).
NLQP_QUERY_TIMEOUT_MS=480000
# Tamaño máximo del resultado completo guardado para paginar/descargar (1 GB).
NLQP_RESULT_MAX_BYTES=1073741824
