{
  "name": "nlqp-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --env-file=.env lib/index.js",
    "start": "node --env-file=.env lib/index.js",
    "test:token": "node --env-file=.env scripts/get_test_token.mjs",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.5.0",
    "@google-cloud/secret-manager": "^5.2.0",
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/vertexai": "^1.12.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "pg": "^8.11.3",
    "mysql2": "^3.9.0",
    "mssql": "^10.0.2",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.10.9",
    "@types/cors": "^2.8.17",
    "@types/mssql": "^12.3.0",
    "typescript": "^5.4.0"
  }
}
