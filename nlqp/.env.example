# Configuración de NLQP en Docker (docker-compose.yml). Copiar a .env y completar.
# Nada de esto es secreto salvo el archivo al que apunta GCP_CREDENTIALS_FILE.

# --- Google Cloud (Vertex AI, Firestore, Secret Manager): los mismos de backend/.env
GCP_PROJECT_ID=
GCP_LOCATION=global
VERTEX_AI_MODEL=gemini-3.8-flash
FIREBASE_PROJECT_ID=

# Credencial de Google Cloud que usa el backend (ruta en ESTA máquina). Opciones:
#   - la de gcloud: `gcloud auth application-default login` y luego, en Windows,
#     C:/Users/<usuario>/AppData/Roaming/gcloud/application_default_credentials.json
#     (en Linux: ~/.config/gcloud/application_default_credentials.json)
#   - la llave JSON de una cuenta de servicio (ver docs/DOCKER.md §4)
GCP_CREDENTIALS_FILE=

# --- Firebase para el navegador: los mismos de frontend/.env.local (son públicos)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Opcional
# Puerto de la red en el que se abre NLQP (por defecto 3000).
# NLQP_PORT=3000
# Puerto local (solo 127.0.0.1) del backend para scripts y pruebas (por defecto 8080).
# NLQP_BACKEND_PORT=8080
# SQL Server con certificado autofirmado (el banco de pruebas): true.
DB_MSSQL_TRUST_SERVER_CERTIFICATE=
