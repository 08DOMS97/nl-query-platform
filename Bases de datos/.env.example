# ============================================================
#  Entorno LOCAL de pruebas - 4 motores de base de datos
# ============================================================
#  Copiar a  .env  y ajustar los valores.  El archivo .env NO
#  se versiona (esta en .gitignore).
#
#  Estas credenciales son de un banco de pruebas local; NO son
#  secretos del sistema NLQP. Las credenciales reales de NLQP
#  viven en Google Cloud Secret Manager (RNF-05).
# ============================================================

# Nombre del proyecto Compose (prefijo de contenedores, red y volumenes)
COMPOSE_PROJECT_NAME=nlqp-bd-pruebas

# ---- Credenciales de la APLICACION (identicas en los 4 motores) ----
# Esta es la cuenta con la que se conecta la app externa.
TEST_DB_NAME=testdb
TEST_DB_USER=testuser
TEST_DB_PASSWORD=CAMBIAR_password_de_la_app

# ---- Credenciales ADMINISTRATIVAS (solo administracion, NO para la app) ----
# Distintas entre si y distintas de la de la aplicacion.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CAMBIAR_admin_postgres
MYSQL_ROOT_PASSWORD=CAMBIAR_admin_mysql
MARIADB_ROOT_PASSWORD=CAMBIAR_admin_mariadb
# SQL Server exige: 8+ caracteres y 3 de 4 categorias (mayus, minus, digito, simbolo)
MSSQL_SA_PASSWORD=CAMBIAR_Admin_SqlServer_1

# ---- Puertos publicados en el host (Windows) ----
MSSQL_HOST_PORT=1433
POSTGRES_HOST_PORT=5432
MYSQL_HOST_PORT=3306
MARIADB_HOST_PORT=3307
